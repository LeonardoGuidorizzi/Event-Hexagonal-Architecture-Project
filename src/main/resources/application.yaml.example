spring:
  application:
    name: Event

  datasource:
    url: jdbc:postgresql://localhost:5431/NameDB
    username: password__
    password: password__
    driver-class-name: org.postgresql.Driver

  jpa:
    show-sql: true

  flyway:
    enabled: true
    location: classpath:db/migration

server:
  port: ${SERVER_PORT:8080}

app:
  auth:
    jwt-secret: ${JWT_SECRET_BASE64} <-- add it in the application environment variables and run the jwtSecretGenerator

management:
  datadog:
    metrics:
      export:
        api-key: ""
        application-key: ""
        uri: "https://app.datadoghq.com"
